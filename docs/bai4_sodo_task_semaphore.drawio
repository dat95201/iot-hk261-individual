        <mxCell id="e3" value="1 TAKE / 3 GIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod" target="mux"><mxGeometry relative="1" as="geometry"/></mxCell>
