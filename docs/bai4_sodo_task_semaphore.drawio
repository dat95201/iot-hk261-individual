<mxfile host="app.diagrams.net">
  <diagram name="Hinh 4.1" id="bai4">
    <mxGraphModel dx="980" dy="690" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Tương tác giữa các task và semaphore" style="text;html=1;align=center;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="prod" value="&lt;b style=&#x27;font-size:16px;color:#1A73E8&#x27;&gt;Task Producer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;priority 2 · chu kỳ 2000 ms&lt;/span&gt;&lt;br&gt;&lt;br&gt;1. xSemaphoreTake(xMutexSerial)&lt;br&gt;2. shared_value++ , in Serial&lt;br&gt;3. xSemaphoreGive(xMutexSerial)&lt;br&gt;4. xSemaphoreGive(binary sem)&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;vTaskDelay(2000 ms) rồi lặp lại&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fillColor=#E8F0FE;strokeColor=#1A73E8;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="280" height="205" as="geometry"/></mxCell>
        <mxCell id="cons" value="&lt;b style=&#x27;font-size:16px;color:#188038&#x27;&gt;Task Consumer&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;priority 3 · block chờ tín hiệu&lt;/span&gt;&lt;br&gt;&lt;br&gt;5. xSemaphoreTake(binary sem)&lt;br&gt;6. xSemaphoreTake(xMutexSerial)&lt;br&gt;7. đọc shared_value , in Serial&lt;br&gt;8. xSemaphoreGive(xMutexSerial)&lt;br&gt;&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;quay lại chờ tín hiệu kế tiếp&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fillColor=#E6F4EA;strokeColor=#188038;" vertex="1" parent="1"><mxGeometry x="670" y="70" width="280" height="205" as="geometry"/></mxCell>
        <mxCell id="sem" value="&lt;b style=&#x27;font-size:15px;color:#B06000&#x27;&gt;Binary Semaphore&lt;/b&gt;&lt;br&gt;xBinarySemaphoreData&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;đồng bộ: báo có dữ liệu mới&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;align=center;spacingLeft=0;verticalAlign=middle;fillColor=#FEF7E0;strokeColor=#F9AB00;" vertex="1" parent="1"><mxGeometry x="375" y="100" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="mux" value="&lt;b style=&#x27;font-size:15px;color:#C5221F&#x27;&gt;Mutex&lt;/b&gt;&lt;br&gt;xMutexSerial&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;loại trừ truy cập đồng thời&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;align=center;spacingLeft=0;verticalAlign=middle;fillColor=#FCE8E6;strokeColor=#D93025;" vertex="1" parent="1"><mxGeometry x="375" y="380" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="shared" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Tài nguyên dùng chung&lt;/b&gt;&lt;br&gt;Serial (USB CDC)&lt;br&gt;biến toàn cục shared_value&lt;br&gt;&lt;span style=&#x27;color:#5F6368;font-size:11px&#x27;&gt;chỉ 1 task được dùng tại một thời điểm&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;align=center;spacingLeft=0;verticalAlign=middle;fillColor=#F1F3F4;strokeColor=#5F6368;dashed=1;" vertex="1" parent="1"><mxGeometry x="320" y="525" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="note" value="Consumer block tại bước 5, được đánh thức khi Producer GIVE ở bước 4" style="text;html=1;align=center;fontSize=12;fontColor=#5F6368;" vertex="1" parent="1"><mxGeometry x="270" y="295" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="e1" value="4 GIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontStyle=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1A73E8;fontColor=#1A73E8;exitX=1;exitY=0.37;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prod" target="sem"><mxGeometry relative="1" as="geometry"/></mxCell>
